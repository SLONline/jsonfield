{
  "name": "slonline/jsonfield",
  "description": "JSON MySQL DB Field - Module for SilverStripe 6",
  "keywords": [
    "silverstripe",
    "CMS",
    "JSON Field"
  ],
  "license": "proprietary",
  "authors": [
    {
      "name": "Lubos Odraska",
      "email": "odraska@slonline.sk",
      "homepage": "https://www.slonline.sk"
    }
  ],
  "require": {
    "silverstripe/framework": "~6"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.3",
    "slonline/silverstripe-mcp": "^6.x-dev"
  },
  "autoload": {
    "psr-4": {
      "SLONline\\ORM\\FieldType\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "SLONline\\ORM\\FieldType\\Tests\\": "tests/php/"
    }
  },
  "minimum-stability": "dev",
  "suggest": {
    "slonline/silverstripe-mcp": "Lets AI agents (MCP) read and write JSON fields, optionally validated by a JSON Schema"
  }
}
